<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EA020617">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="440dp"
                android:orientation="vertical"
                android:background="#1E293B"
                android:padding="24dp"
                android:gravity="center_horizontal"
                android:elevation="10dp">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="🔒"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:background="#26EF4444"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tv_lock_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Application Locked"
                    android:textColor="#F8FAFC"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_lock_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Is application ka purchase verify nahi hua hai ya refund ho chuka hai. BioCraft ko chalane ke liye kripya ise Google Play Store se khareedein."
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btn_buy_playstore"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Buy on Google Play"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#059669"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_retry_check"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Retry Verification"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:backgroundTint="#334155"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_exit_app"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Exit Game"
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    android:backgroundTint="#0F172A" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
